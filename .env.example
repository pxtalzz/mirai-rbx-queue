# Discord Bot Token
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord Server ID
SERVER_ID=your_server_id_here

# Staff Role ID (only staff can manage the queue)
STAFF_ROLE_ID=your_staff_role_id_here

# Queue Display Channel ID (where the queue embed will be posted)
QUEUE_CHANNEL_ID=your_queue_channel_id_here

# Log Channel ID (where queue actions will be logged)
LOG_CHANNEL_ID=your_log_channel_id_here

# Database file location (for storing queue data)
DATABASE_PATH=queue_data.db
